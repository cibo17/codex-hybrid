diff --git a/src/tools/keyPool.ts b/src/tools/keyPool.ts
new file mode 100644
index 0000000..897cbb6
--- /dev/null
+++ b/src/tools/keyPool.ts
@@ -0,0 +1,72 @@
+import fs from "node:fs";
+import { ExaError } from "exa-js";
+
+const AUTH_COOLDOWN_MS = 6 * 60 * 60 * 1000;
+const RATE_LIMIT_COOLDOWN_MS = 20 * 60 * 1000;
+const SERVER_COOLDOWN_MS = 60 * 1000;
+
+export function loadExaKeys(file: string): string[] {
+  const seen = new Set<string>();
+  return fs
+    .readFileSync(file, "utf8")
+    .split(/\r?\n/)
+    .map((line) => line.trim())
+    .filter((line) => line.length > 0 && !line.startsWith("#"))
+    .filter((key) => {
+      if (seen.has(key)) return false;
+      seen.add(key);
+      return true;
+    });
+}
+
+function cooldownMs(error: unknown): number | null {
+  if (!(error instanceof ExaError)) return null;
+  if (error.statusCode === 401 || error.statusCode === 403) return AUTH_COOLDOWN_MS;
+  if (error.statusCode === 429) return RATE_LIMIT_COOLDOWN_MS;
+  if (error.statusCode >= 500) return SERVER_COOLDOWN_MS;
+  return null;
+}
+
+export class ExaKeyPool {
+  private cursor = 0;
+  private readonly cooldowns = new Map<string, number>();
+
+  constructor(private readonly file: string) {}
+
+  async run<T>(operation: (key: string) => Promise<T>, now = Date.now()): Promise<T> {
+    const keys = loadExaKeys(this.file);
+    if (keys.length === 0) throw new Error(`No Exa API keys found in ${this.file}`);
+
+    const start = this.cursor % keys.length;
+    this.cursor = (start + 1) % keys.length;
+    const ordered = [...keys.slice(start), ...keys.slice(0, start)];
+    const available = ordered.filter((key) => (this.cooldowns.get(key) ?? 0) <= now);
+    if (available.length === 0) throw new Error("All Exa API keys are cooling down");
+
+    let lastError: unknown;
+    for (const key of available) {
+      try {
+        const result = await operation(key);
+        this.cooldowns.delete(key);
+        return result;
+      } catch (error) {
+        const duration = cooldownMs(error);
+        if (duration === null) throw error;
+        this.cooldowns.set(key, now + duration);
+        lastError = error;
+      }
+    }
+    throw lastError ?? new Error("All Exa API keys failed");
+  }
+}
+
+const pools = new Map<string, ExaKeyPool>();
+
+export function keyPoolFor(file: string): ExaKeyPool {
+  let pool = pools.get(file);
+  if (!pool) {
+    pool = new ExaKeyPool(file);
+    pools.set(file, pool);
+  }
+  return pool;
+}

diff --git a/tests/unit/tools/keyPool.test.ts b/tests/unit/tools/keyPool.test.ts
new file mode 100644
index 0000000..588bec5
--- /dev/null
+++ b/tests/unit/tools/keyPool.test.ts
@@ -0,0 +1,59 @@
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { afterEach, describe, expect, it } from "vitest";
+import { ExaError } from "exa-js";
+import { ExaKeyPool, loadExaKeys } from "../../../src/tools/keyPool.js";
+
+const temporaryDirectories: string[] = [];
+
+function keysFile(contents: string): string {
+  const directory = fs.mkdtempSync(path.join(os.tmpdir(), "exa-key-pool-"));
+  temporaryDirectories.push(directory);
+  const file = path.join(directory, "keys.txt");
+  fs.writeFileSync(file, contents);
+  return file;
+}
+
+afterEach(() => {
+  for (const directory of temporaryDirectories.splice(0)) {
+    fs.rmSync(directory, { recursive: true, force: true });
+  }
+});
+
+describe("ExaKeyPool", () => {
+  it("loads unique non-comment keys", () => {
+    const file = keysFile("first\n# ignored\nsecond\nfirst\n");
+    expect(loadExaKeys(file)).toEqual(["first", "second"]);
+  });
+
+  it("rotates successful calls", async () => {
+    const pool = new ExaKeyPool(keysFile("first\nsecond\n"));
+    await expect(pool.run(async (key) => key)).resolves.toBe("first");
+    await expect(pool.run(async (key) => key)).resolves.toBe("second");
+  });
+
+  it("cools a rate-limited key and retries the next key", async () => {
+    const pool = new ExaKeyPool(keysFile("first\nsecond\n"));
+    const attempted: string[] = [];
+    const result = await pool.run(async (key) => {
+      attempted.push(key);
+      if (key === "first") throw new ExaError("limited", 429);
+      return key;
+    });
+    expect(result).toBe("second");
+    expect(attempted).toEqual(["first", "second"]);
+  });
+
+  it("does not rotate on a caller error", async () => {
+    const pool = new ExaKeyPool(keysFile("first\nsecond\n"));
+    const attempted: string[] = [];
+    await expect(
+      pool.run(async (key) => {
+        attempted.push(key);
+        throw new ExaError("bad request", 400);
+      }),
+    ).rejects.toMatchObject({ statusCode: 400 });
+    expect(attempted).toEqual(["first"]);
+  });
+});
